# The port Selkies serves the desktop on. module.yaml's Desktop URL and the desktop image's
# ghostdock.url.desktop.port label name the same number (tests/nuxt/images/desktop-module.test.ts).
# Away from the ports a VM's own apps tend to use (3000, 5173, 8080, …) and below Linux's
# ephemeral range (32768+), so neither takes it first.
SELKIES_PORT=14080
