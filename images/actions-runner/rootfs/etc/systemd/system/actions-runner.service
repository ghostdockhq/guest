[Unit]
Description=GitHub Actions runner: one job, then the VM powers off
Documentation=https://docs.ghostdock.ai
# gdo-guest is ready once the host's first config is applied: the VM env is in /run/ghostdock.
# Not after docker.service: dockerd starts beside the runner (1-3 s) instead of before it, and
# the job-started hook below waits for it before a job's first step.
After=gdo-guest.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=runner
Group=runner
WorkingDirectory=/home/runner
# The VM env: the runner scale set gives each job VM its single-use registration as
# ACTIONS_RUNNER_INPUT_JITCONFIG, which run.sh reads as its --jitconfig.
EnvironmentFile=-/run/ghostdock/env
Environment=HOME=/home/runner
# Before a job's first step (and its containers), Docker answers: the runner no longer starts after
# dockerd, so a job assigned within a second or two could otherwise meet no engine. The runner
# runs a hook only by its extension (.sh, .ps1 or .js): without one it fails every job (2026-11-24).
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED=/usr/lib/ghostdock/actions-runner-wait-docker.sh
# A VM without a registration (a plain Server of this image) skips the runner and stays up.
# actions-runner.path starts it again whenever the VM env is written, so a registration that
# arrives after the boot's start still runs.
# One runner per boot: the first start leaves /run/actions-runner.started, and every later
# start is skipped. A config push between the job's end and the poweroff would otherwise queue
# run.sh again with the used registration; the VM, not GitHub's single-use registration,
# keeps it to one job.
ExecCondition=/bin/sh -c 'test -n "$${ACTIONS_RUNNER_INPUT_JITCONFIG:-}" && test ! -e /run/actions-runner.started'
ExecStartPre=+/bin/touch /run/actions-runner.started
# A job's first `apt-get` must not meet the lock of the first boot's list fetch (gdo-apt-lists,
# headless image), as on a GitHub-hosted runner: wait for it, at most two minutes. The image ships
# the lists, so the fetch skips itself and this ends at once; it stays for an image built on this
# one that removes them.
ExecStartPre=/bin/sh -c 'for i in $$(seq 120); do systemctl is-active --quiet gdo-apt-lists.service || exit 0; sleep 1; done'
ExecStart=/home/runner/run.sh
# One job: when the runner ends, the VM powers off, and an ephemeral VM is then deleted.
ExecStopPost=+/usr/lib/ghostdock/actions-runner-done
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
