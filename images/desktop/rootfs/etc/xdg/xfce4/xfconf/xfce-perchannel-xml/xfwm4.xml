<?xml version="1.0" encoding="UTF-8"?>
<!-- System defaults for the window manager; xfwm4's built-in defaults fill
     in the rest. The frames are the Ghostdock theme, dark (drawn by
     desktop/theme/xfwm4.py); Ghostdock-xhdpi replaces it at 2x. Compositing
     is on for the frames' shadows and rounded corners and the dock's
     translucency: it measured about a tenth more CPU while dragging a
     window, next to Selkies' encoder. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Ghostdock"/>
    <property name="title_font" type="string" value="Inter Variable Semi-Bold 10"/>
    <property name="title_alignment" type="string" value="center"/>
    <property name="button_layout" type="string" value="CHM|"/>
    <property name="use_compositing" type="bool" value="true"/>
    <property name="vblank_mode" type="string" value="off"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="show_popup_shadow" type="bool" value="true"/>
    <property name="show_dock_shadow" type="bool" value="false"/>
    <property name="borderless_maximize" type="bool" value="true"/>
    <property name="placement_mode" type="string" value="center"/>
    <property name="placement_ratio" type="int" value="100"/>
    <property name="cycle_preview" type="bool" value="false"/>
    <property name="workspace_count" type="int" value="1"/>
  </property>
</channel>
