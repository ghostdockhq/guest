# The desktop units' shared environment (gdo-xvfb, gdo-desktop, gdo-selkies).
# /run/ghostdock-desktop holds the X cookie, made at every boot by
# gdo-desktop-prepare.service; /run/user/1000 is ghost's runtime directory,
# kept by logind from boot on (ghost lingers), with the session D-Bus and
# PipeWire's PulseAudio socket. Selkies is not in the login session and
# finds them through these variables.
HOME=/home/ghost
DISPLAY=:1
XAUTHORITY=/run/ghostdock-desktop/Xauthority
XDG_RUNTIME_DIR=/run/user/1000
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
XCURSOR_THEME=Adwaita
# A display manager sets these from the session's .desktop file (xfce.desktop).
# The menu bar's Desktop menu picks its settings apps by XDG_CURRENT_DESKTOP
# (without it, gnome-control-center, which is not here), as do menus,
# default applications and the portals (xfce-portals.conf).
XDG_CURRENT_DESKTOP=XFCE
XDG_SESSION_DESKTOP=xfce
DESKTOP_SESSION=xfce
XDG_MENU_PREFIX=xfce-
LANG=en_US.UTF-8
# desktop-bin first: its xfconf-query turns the DPI Selkies sets into a
# window scale (Selkies runs it with the session's environment).
PATH=/usr/lib/ghostdock/desktop-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
